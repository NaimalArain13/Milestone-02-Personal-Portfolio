@@ -0,0 +1,61 @@
+"use client"
+import { useRef } from "react"
+import gsap from "gsap"
+import { useGSAP } from "@gsap/react"
+
+gsap.registerPlugin(useGSAP)
+
+export default function Cursor() {
+  const ringRef = useRef<HTMLDivElement>(null)
+  const dotRef  = useRef<HTMLDivElement>(null)
+
+  const { contextSafe } = useGSAP(() => {
+    const xRing = gsap.quickTo(ringRef.current, "x", { duration: 0.5, ease: "power3" })
+    const yRing = gsap.quickTo(ringRef.current, "y", { duration: 0.5, ease: "power3" })
+    const xDot  = gsap.quickTo(dotRef.current,  "x", { duration: 0.08 })
+    const yDot  = gsap.quickTo(dotRef.current,  "y", { duration: 0.08 })
+
+    const onMove = (e: MouseEvent) => {
+      xRing(e.clientX); yRing(e.clientY)
+      xDot(e.clientX);  yDot(e.clientY)
+    }
+    window.addEventListener("mousemove", onMove)
+    return () => window.removeEventListener("mousemove", onMove)
+  })
+
+  useGSAP(() => {
+    const scaleUp   = contextSafe(() => gsap.to(ringRef.current, { scale: 1.8, duration: 0.3, ease: "power2.out" }))
+    const scaleLg   = contextSafe(() => gsap.to(ringRef.current, { scale: 2.5, duration: 0.3, ease: "power2.out" }))
+    const scaleDown = contextSafe(() => gsap.to(ringRef.current, { scale: 1,   duration: 0.3, ease: "power2.out" }))
+    const press     = contextSafe(() => gsap.to(ringRef.current, { scale: 0.8, duration: 0.1 }))
+    const release   = contextSafe(() => gsap.to(ringRef.current, { scale: 1,   duration: 0.15 }))
+
+    const over = (e: MouseEvent) => {
+      const t = e.target as HTMLElement
+      if (t.closest(".project-card")) scaleLg()
+      else if (t.closest("a, button")) scaleUp()
+    }
+    const out = (e: MouseEvent) => {
+      const t = e.target as HTMLElement
+      if (t.closest(".project-card") || t.closest("a, button")) scaleDown()
+    }
+
+    document.addEventListener("mouseover",  over)
+    document.addEventListener("mouseout",   out)
+    document.addEventListener("mousedown",  press)
+    document.addEventListener("mouseup",    release)
+    return () => {
+      document.removeEventListener("mouseover",  over)
+      document.removeEventListener("mouseout",   out)
+      document.removeEventListener("mousedown",  press)
+      document.removeEventListener("mouseup",    release)
+    }
+  })
+
+  return (
+    <>
+      <div ref={ringRef} className="cursor-ring" />
+      <div ref={dotRef}  className="cursor-dot"  />
+    </>
+  )
+}
